{#
  The settings this role owns -- NOT the whole file. Wings writes its complete
  config (every default filled in) back to disk at boot, so the role merges
  these keys into whatever is there and writes only when a value differs.
  Anything not listed here stays as Wings wrote it. Credentials go through
  to_json so they always parse back as strings.
#}
debug: false
uuid: {{ pelican_node_uuid | to_json }}
token_id: {{ pelican_node_token_id | to_json }}
token: {{ pelican_node_token | to_json }}

api:
  host: 0.0.0.0
  port: 8080
  # TLS is terminated by the Envoy gateway in front of this node, so Wings
  # itself speaks plain HTTP. See the spec, decision D2.
  ssl:
    enabled: false
  upload_limit: {{ pelican_wings_upload_limit }}
  trusted_proxies:
{% for cidr in pelican_wings_trusted_proxies %}
    - "{{ cidr }}"
{% endfor %}

system:
  root_directory: {{ pelican_wings_root }}
  data: {{ pelican_wings_data }}
  backup_directory: {{ pelican_wings_backup_dir }}
  username: pelican
  timezone: {{ pelican_wings_timezone }}
  sftp:
    bind_address: 0.0.0.0
    bind_port: 2022

remote: {{ pelican_panel_url }}

allowed_origins:
  - "{{ pelican_panel_url }}"
