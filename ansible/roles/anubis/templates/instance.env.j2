{{ ansible_managed | comment }}
BIND={{ anubis_bind }}
METRICS_BIND={{ anubis_metrics_bind }}
# Subrequest mode. Caddy asks Anubis for a verdict on each request and keeps
# proxying the upstream itself; a single space is Anubis's documented value
# for "there is no upstream". systemd strips the quotes and keeps the space.
TARGET=" "
POLICY_FNAME=/etc/anubis/{{ anubis_instance }}.botPolicies.yaml
REDIRECT_DOMAINS={{ anubis_redirect_domains | join(',') }}
SERVE_ROBOTS_TXT={{ '1' if anubis_serve_robots_txt else '0' }}
{% if anubis_webmaster_email %}
WEBMASTER_EMAIL={{ anubis_webmaster_email }}
{% endif %}
