{{ ansible_managed | comment }}
# Upstream's default policy (data/botPolicies.yaml at {{ anubis_version }}) with
# two changes.
#
# DENY answers 403 instead of 200: in subrequest mode the proxy reads the
# check endpoint's status code, and a 200 means "let it through", so with the
# default a denied client would be waved in.
#
# Upstream's country and ASN rules are replaced by one country rule of our
# own: every visitor outside Thailand weighs 10 more. The country comes from
# DB-IP's free database, kept current by the anubis-geoip-update timer.
#
# The moderate tier (weight 10-19, where a plain browser lands) is raised from
# difficulty 2 to 4.
bots:
  - import: (data)/bots/_deny-pathological.yaml
  - import: (data)/bots/aggressive-brazilian-scrapers.yaml
  - import: (data)/common/domain-fronting.yaml
  - import: (data)/meta/ai-block-aggressive.yaml
  - import: (data)/crawlers/_allow-good.yaml
  - import: (data)/clients/x-firefox-ai.yaml
  - import: (data)/crawlers/xai.yaml
  - import: (data)/common/keep-internet-working.yaml
  # RSS/Atom feeds (Hugo: /index.xml and /<section>/index.xml). Feed readers
  # can't run the challenge, and hosted ones (Feedly, Inoreader) fetch from
  # outside Thailand, so without this every subscriber silently stops getting
  # posts. Shared policy, but no other protected site serves these paths.
  - name: rss-feeds
    path_regex: ^/(.+/)?index\.xml$
    action: ALLOW
  - name: generic-browser
    user_agent_regex: >-
      Mozilla|Opera
    action: WEIGH
    weight:
      adjust: 10
  # "Everyone outside Thailand": Anubis can only match a LIST of countries,
  # with no negation and no country variable in expressions. So weigh every
  # request, then take the weight back for Thailand. An address the database
  # cannot place counts as outside Thailand.
  - name: outside-thailand
    path_regex: .*
    action: WEIGH
    weight:
      adjust: 10
  - name: thailand
    action: WEIGH
    geoip:
      countries:
        - TH
    weight:
      adjust: -10

geoip:
  country:
    path: /var/lib/anubis-geoip/dbip-country-lite.mmdb

dnsbl: false

honeypot:
  enabled: true
  implementation: naive

openGraph:
  enabled: false
  considerHost: false
  ttl: 24h

status_codes:
  CHALLENGE: 200
  DENY: 403

store:
  backend: memory
  parameters: {}

thresholds:
  - name: minimal-suspicion
    expression: weight <= 0
    action: ALLOW
  - name: mild-suspicion
    expression:
      all:
        - weight > 0
        - weight < 10
    action: CHALLENGE
    challenge:
      algorithm: metarefresh
      difficulty: 1
  - name: moderate-suspicion
    expression:
      all:
        - weight >= 10
        - weight < 20
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 4
  - name: mild-proof-of-work
    expression:
      all:
        - weight >= 20
        - weight < 30
    action: CHALLENGE
    challenge:
      algorithm: fast
      difficulty: 4
  - name: extreme-suspicion
    expression: weight >= 30
    action: DENY
