{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Asia/Bangkok",
  "schedule": [
    "before 6am"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "labels": [
    "renovate"
  ],
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
    "**/.terragrunt-cache/**",
    ".venv/**",
    "site/**",
    "scratchpad/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^docker/compose/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "DERP relay: track derper against tailscale/tailscale releases",
      "managerFilePatterns": [
        "/^ansible/roles/tailscale_derp/defaults/main\\.yaml$/",
        "/^ansible/inventory/group_vars/edge\\.yaml$/"
      ],
      "matchStrings": [
        "derper_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Pelican Wings: the daemon binary installed on the games group",
      "managerFilePatterns": [
        "/^ansible/roles/pelican_wings/defaults/main\\.yaml$/",
        "/^ansible/inventory/group_vars/games\\.yaml$/"
      ],
      "matchStrings": [
        "pelican_wings_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "pelican/wings",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Caddy: rebuilt from source with caddy-l4, so the version is pinned here rather than apt",
      "managerFilePatterns": [
        "/^ansible/roles/caddy_gateway/defaults/main\\.yaml$/",
        "/^ansible/inventory/group_vars/edge\\.yaml$/"
      ],
      "matchStrings": [
        "caddy_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "caddyserver/caddy",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "caddy-l4: the layer4 module compiled into the custom Caddy build",
      "managerFilePatterns": [
        "/^ansible/roles/caddy_gateway/defaults/main\\.yaml$/",
        "/^ansible/inventory/group_vars/edge\\.yaml$/"
      ],
      "matchStrings": [
        "caddy_l4_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "mholt/caddy-l4",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Anubis: the bot-challenge .deb installed on the edge group",
      "managerFilePatterns": [
        "/^ansible/roles/anubis/defaults/main\\.yaml$/",
        "/^ansible/inventory/group_vars/edge\\.yaml$/"
      ],
      "matchStrings": [
        "anubis_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "TecharoHQ/anubis",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "OpenTelemetry Collector contrib: the .deb installed on the edge group",
      "managerFilePatterns": [
        "/^ansible/roles/otel_collector/defaults/main\\.yaml$/"
      ],
      "matchStrings": [
        "otelcol_version:\\s*\"?(?<currentValue>v[0-9][^\"\\s#]*)\"?"
      ],
      "depNameTemplate": "open-telemetry/opentelemetry-collector-releases",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Batch the *arr stack into one PR; they are upgraded together in practice",
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "arr stack"
    },
    {
      "description": "Observability images move together",
      "matchPackageNames": [
        "grafana/**",
        "otel/**",
        "ghcr.io/prometheus/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "observability"
    },
    {
      "description": "Major bumps always get their own PR and a changelog read",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Let a release settle before proposing it",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Patch, pin and digest updates merge themselves once validate passes",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Minor updates automerge too",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "The *arr apps and Jellyfin migrate their SQLite databases on upgrade and the migration is not reversible. Their config PVCs are on local-path with no backup, so a bad upgrade means rebuilding config by hand. Keep a human on anything beyond a patch.",
      "matchPackageNames": [
        "lscr.io/linuxserver/**",
        "jellyfin"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "Majors always get a human and a changelog read",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "The Intel operator and GPU plugin must stay on the same version; a skew breaks GPU device registration and with it Jellyfin transcoding. One PR, and never automerged.",
      "matchPackageNames": [
        "intel-device-plugins-operator",
        "intel-device-plugins-gpu"
      ],
      "groupName": "intel device plugins",
      "automerge": false
    },
    {
      "description": "Pelican is pre-1.0 and ships release candidates. Renovate skips prereleases by default, so without ignoreUnstable it would never propose a bump at all. Breaking changes between RCs are realistic -- always a human and a changelog read.",
      "matchPackageNames": [
        "pelican/**",
        "ghcr.io/pelican/**"
      ],
      "ignoreUnstable": false,
      "automerge": false
    },
    {
      "description": "Updated by Flux image automation (kubernetes/apps/image-automation), not Renovate. Two writers on one line would fight.",
      "matchPackageNames": [
        "ghcr.io/fordkuppp/blog"
      ],
      "enabled": false
    }
  ],
  "platformAutomerge": false
}
